# Copy outside the repository or export variables in your terminal.
# Use a gateway key for /v1/chat/completions, not a Claude CLI access token.
OMNIROUTE_API_KEY=
# Explicitly select a model available in your gateway. No paid model is selected automatically.
OMNIROUTE_MODEL=
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
# Optional native engine configuration
GHIDRA_INSTALL_DIR=
JAVA_HOME=
